# microservice specific routes

->         /hmrc-frontend                               hmrcfrontend.Routes

->         /change-registration-details/business-name               businessname.Routes
->         /change-registration-details/business-address            businessaddress.Routes
->         /change-registration-details/partner-details             partnerdetails.Routes
->         /change-registration-details/licences-and-premises       licencespremises.Routes
->         /change-registration-details/business-contact-details    businesscontactdetails.Routes
->         /change-registration-details/correspondence-details      correspondencedetails.Routes
->         /change-registration-details/trading-details             tradingdetails.Routes
->         /change-registration-details/controlling-body-details    controllingbodydetails.Routes
->         /change-registration-details/return-periods              returnperiods.Routes
->         /                                                        cancellation.Routes

GET        /                                            controllers.IndexController.onPageLoad()

GET        /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET        /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET        /refresh-session                             controllers.KeepAliveController.keepAlive()

GET        /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET        /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET        /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET        /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET        /there-is-a-problem-with-the-service         controllers.SystemErrorController.onPageLoad()

GET        /there-is-a-problem-access-denied            controllers.AccessDeniedController.onPageLoad()
GET        /page-not-found                              controllers.PageNotFoundController.onPageLoad()

GET        /change-registration-details                 controllers.ChangeRegistrationDetailsController.onPageLoad()

GET        /change-registration-details/declaration             controllers.DeclarationController.onPageLoad()
POST       /change-registration-details/declaration             controllers.DeclarationController.onSubmit()

GET        /address-lookup                          controllers.AddressLookupController.initialise()
GET        /address-lookup/callback                 controllers.AddressLookupController.callback(id: String)

# Landing url - These are used by gambling-management-frontend

# CANCELLATION

GET        /change-registration-details/controlling-body-details/check                            controllers.controllingbody.CheckControllingBodyDetailsController.onPageLoad()
POST       /change-registration-details/controlling-body-details/check                            controllers.controllingbody.CheckControllingBodyDetailsController.onSubmit()

GET        /cancel-registration/why-are-you-cancelling                               controllers.cancellation.ReasonForCancellationController.onPageLoad(mode: Mode = NormalMode)
POST       /cancel-registration/why-are-you-cancelling                               controllers.cancellation.ReasonForCancellationController.onSubmit(mode: Mode = NormalMode)

GET        /cancel-registration/change-why-are-you-cancelling                        controllers.cancellation.ReasonForCancellationController.onPageLoad(mode: Mode = CheckMode)
POST       /cancel-registration/change-why-are-you-cancelling                        controllers.cancellation.ReasonForCancellationController.onSubmit(mode: Mode = CheckMode)

GET        /cancel-registration/group-registration-number                        controllers.cancellation.ChangeGroupRegistrationNumberController.onPageLoad(mode: Mode = NormalMode)
POST       /cancel-registration/group-registration-number                        controllers.cancellation.ChangeGroupRegistrationNumberController.onSubmit(mode: Mode = NormalMode)

GET        /cancel-registration/change-group-registration-number                        controllers.cancellation.ChangeGroupRegistrationNumberController.onPageLoad(mode: Mode = CheckMode)
POST       /cancel-registration/change-group-registration-number                        controllers.cancellation.ChangeGroupRegistrationNumberController.onSubmit(mode: Mode = CheckMode)

GET        /cancel-registration/no-longer-liable                  controllers.cancellation.CancelRegistrationDateController.onPageLoad(mode: Mode = NormalMode)
POST       /cancel-registration/no-longer-liable                  controllers.cancellation.CancelRegistrationDateController.onSubmit(mode: Mode = NormalMode)

GET        /cancel-registration/change-no-longer-liable                        controllers.cancellation.CancelRegistrationDateController.onPageLoad(mode: Mode = CheckMode)
POST       /cancel-registration/change-no-longer-liable                        controllers.cancellation.CancelRegistrationDateController.onSubmit(mode: Mode = CheckMode)

GET        /cancel-group-registration/no-longer-liable                  controllers.cancellation.CancelGroupRegistrationDateController.onPageLoad(mode: Mode = NormalMode)
POST       /cancel-group-registration/no-longer-liable                  controllers.cancellation.CancelGroupRegistrationDateController.onSubmit(mode: Mode = NormalMode)

GET        /cancel-group-registration/change-no-longer-liable                  controllers.cancellation.CancelGroupRegistrationDateController.onPageLoad(mode: Mode = CheckMode)
POST       /cancel-group-registration/change-no-longer-liable                  controllers.cancellation.CancelGroupRegistrationDateController.onSubmit(mode: Mode = CheckMode)

GET        /cancel-group-registration/reviewing-cancellation-request   controllers.cancellation.RegistrationCancellationWarningController.onPageLoad(mode: Mode = NormalMode)
POST       /cancel-group-registration/reviewing-cancellation-request   controllers.cancellation.RegistrationCancellationWarningController.onSubmit(mode: Mode = NormalMode)

GET        /cancel-registration/check                                   controllers.cancellation.CheckRegistrationCancellationDetailsController.onPageLoad(mode: Mode = NormalMode)
GET        /cancel-group-registration/check                             controllers.cancellation.CheckGroupRegistrationCancellationDetailsController.onPageLoad()

GET        /cancel-group-registration/submitted                         controllers.cancellation.RegistrationCancellationConfirmationController.onPageLoadGroup()

GET        /cancel-registration/already-cancelled                       controllers.cancellation.RegistrationCancellationLockedController.onPageLoad(mode: Mode = NormalMode)

GET        /cancel-registration/submitted                       controllers.cancellation.RegistrationCancellationConfirmationController.onPageLoad()

GET        /cancel-registration/declaration                      controllers.cancellation.RegistrationCancellationDeclarationController.onPageLoad()
POST       /cancel-registration/declaration                      controllers.cancellation.RegistrationCancellationDeclarationController.onSubmit()

GET        /cancel-group-registration/declaration                controllers.cancellation.RegistrationCancellationDeclarationController.onPageLoad()
POST       /cancel-group-registration/declaration                controllers.cancellation.RegistrationCancellationDeclarationController.onSubmit()
GET        /:regNumber/change-registration-details      controllers.ChangeRegistrationDetailsController.onLanding(regNumber: String)
