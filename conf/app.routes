# microservice specific routes

->         /hmrc-frontend                               hmrcfrontend.Routes

->         /change-registration-details/business-name               businessname.Routes
->         /change-registration-details/business-address            businessaddress.Routes
->         /change-registration-details/partner-details             partnerdetails.Routes
->         /change-registration-details/licences-and-premises       licencespremises.Routes
->         /change-registration-details/business-contact-details    businesscontactdetails.Routes
->         /change-registration-details/correspondence-details      correspondencedetails.Routes
->         /change-registration-details/trading-details             tradingdetails.Routes
->         /change-registration-details/controlling-body-details    controllingbodydetails.Routes
->         /change-registration-details/return-periods              returnperiods.Routes
->         /cancel-registration                                     cancellations.Routes
->         /cancel-group-registration                               cancelgroup.Routes

GET        /                                            controllers.IndexController.onPageLoad()

GET        /assets/*file                                controllers.Assets.versioned(path="/public", file: Asset)

GET        /language/:lang                              controllers.LanguageSwitchController.switchToLanguage(lang: String)

GET        /refresh-session                             controllers.KeepAliveController.keepAlive()

GET        /there-is-a-problem                          controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET        /account/sign-out-survey                     controllers.auth.AuthController.signOut()
GET        /account/sign-out                            controllers.auth.AuthController.signOutNoSurvey()
GET        /account/signed-out                          controllers.auth.SignedOutController.onPageLoad()

GET        /there-is-a-problem-with-the-service         controllers.SystemErrorController.onPageLoad()

GET        /there-is-a-problem-access-denied            controllers.AccessDeniedController.onPageLoad()
GET        /page-not-found                              controllers.PageNotFoundController.onPageLoad()

GET        /change-registration-details                 controllers.ChangeRegistrationDetailsController.onPageLoad()

GET        /change-registration-details/declaration             controllers.DeclarationController.onPageLoad()
POST       /change-registration-details/declaration             controllers.DeclarationController.onSubmit()

GET        /change-registration-details/remove-trading-name                                    controllers.businessname.RemoveTradeNameController.onPageLoad(mode: Mode = NormalMode)
POST       /change-registration-details/remove-trading-name                                    controllers.businessname.RemoveTradeNameController.onSubmit(mode: Mode = NormalMode)

GET        /address-lookup                          controllers.AddressLookupController.initialise()
GET        /address-lookup/callback                 controllers.AddressLookupController.callback(id: String)

# Landing url - These are used by gambling-management-frontend

GET        /:regNumber/change-registration-details      controllers.ChangeRegistrationDetailsController.onLanding(regNumber: String)
GET        /:regNumber/cancel-registration              controllers.cancellation.CancelRegistrationDateController.onLanding(regNumber: String)
